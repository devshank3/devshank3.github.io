---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const projects = (await getCollection('projects'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 2);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<!-- Hero -->
	<section class="relative overflow-hidden">
		<div
			class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(55%_45%_at_50%_0%,var(--color-accent-100),transparent)] dark:bg-[radial-gradient(55%_45%_at_50%_0%,var(--color-accent-900),transparent)] dark:opacity-30"
		>
		</div>
		<div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 sm:py-28">
			<span
				class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white/60 px-3 py-1 text-xs font-medium text-zinc-600 backdrop-blur dark:border-zinc-800 dark:bg-zinc-900/60 dark:text-zinc-300"
			>
				<span class="h-2 w-2 rounded-full bg-green-500"></span>
				Available for collaboration
			</span>
			<h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-6xl">
				Hi, I'm <span class="text-accent-600 dark:text-accent-400">Shankar</span> 👋
			</h1>
			<p class="mx-auto mt-6 max-w-xl text-lg text-zinc-600 dark:text-zinc-400">
				Software engineer crafting things with .NET, Azure & a curiosity for medical imaging.
				Welcome to my corner of the web — thoughts, projects & experiments.
			</p>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a
					href="/blog"
					class="inline-flex items-center gap-2 rounded-lg bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-accent-700"
				>
					Read the blog
				</a>
				<a
					href="/about"
					class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 px-5 py-2.5 text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-800"
				>
					About me
				</a>
			</div>
		</div>
	</section>

	<!-- Latest posts -->
	<section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
		<div class="mb-8 flex items-end justify-between">
			<h2 class="text-2xl font-bold tracking-tight">Latest posts</h2>
			<a href="/blog" class="text-sm font-medium text-accent-600 hover:underline dark:text-accent-400">
				View all →
			</a>
		</div>
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				posts.map((post) => (
					<a
						href={`/blog/${post.id}/`}
						class="group flex flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white transition-all hover:-translate-y-1 hover:shadow-xl dark:border-zinc-800 dark:bg-zinc-900"
					>
						{post.data.heroImage && (
							<Image
								width={720}
								height={360}
								src={post.data.heroImage}
								alt={post.data.title}
								class="aspect-video w-full object-cover"
							/>
						)}
						<div class="flex flex-1 flex-col p-5">
							<p class="text-xs text-zinc-500 dark:text-zinc-400">
								<FormattedDate date={post.data.pubDate} />
							</p>
							<h3 class="mt-2 font-semibold text-zinc-900 group-hover:text-accent-600 dark:text-zinc-100 dark:group-hover:text-accent-400">
								{post.data.title}
							</h3>
							<p class="mt-2 line-clamp-2 text-sm text-zinc-600 dark:text-zinc-400">
								{post.data.description}
							</p>
						</div>
					</a>
				))
			}
		</div>
	</section>

	<!-- Featured projects -->
	{
		projects.length > 0 && (
			<section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
				<div class="mb-8 flex items-end justify-between">
					<h2 class="text-2xl font-bold tracking-tight">Featured projects</h2>
					<a href="/projects" class="text-sm font-medium text-accent-600 hover:underline dark:text-accent-400">
						View all →
					</a>
				</div>
				<div class="grid gap-6 sm:grid-cols-2">
					{projects.map((project) => (
						<a
							href={`/projects/${project.id}/`}
							class="group flex flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white transition-all hover:-translate-y-1 hover:shadow-xl dark:border-zinc-800 dark:bg-zinc-900"
						>
							{project.data.heroImage && (
								<Image
									width={720}
									height={360}
									src={project.data.heroImage}
									alt={project.data.title}
									class="aspect-video w-full object-cover"
								/>
							)}
							<div class="flex flex-1 flex-col p-5">
								<h3 class="font-semibold text-zinc-900 group-hover:text-accent-600 dark:text-zinc-100 dark:group-hover:text-accent-400">
									{project.data.title}
								</h3>
								<p class="mt-2 line-clamp-2 text-sm text-zinc-600 dark:text-zinc-400">
									{project.data.description}
								</p>
							</div>
						</a>
					))}
				</div>
			</section>
		)
	}
</BaseLayout>
