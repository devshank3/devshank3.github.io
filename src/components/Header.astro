---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header
	class="sticky top-0 z-50 border-b border-zinc-200/80 bg-white/80 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/80"
>
	<nav class="mx-auto flex max-w-5xl items-center justify-between gap-2 px-4 py-3 sm:px-6">
		<a
			href="/"
			class="text-base font-bold tracking-tight text-zinc-900 transition-colors hover:text-accent-600 dark:text-zinc-100 dark:hover:text-accent-400"
		>
			{SITE_TITLE}
		</a>

		<!-- Desktop nav -->
		<div class="hidden items-center gap-1 md:flex">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/tags">Tags</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<div class="flex items-center gap-1">
			<a
				href="https://github.com/devshank3"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
			>
				<span class="sr-only">Go to my GitHub profile</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>

			<ThemeToggle />

			<!-- Hamburger (mobile) -->
			<button
				id="hamburger-btn"
				type="button"
				aria-label="Toggle navigation menu"
				aria-expanded="false"
				class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-900 md:hidden dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
			>
				<svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
				<svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>
	</nav>

	<!-- Mobile menu -->
	<div
		id="mobile-menu"
		class="grid grid-rows-[0fr] overflow-hidden transition-all duration-300 ease-in-out md:hidden"
	>
		<div class="min-h-0">
			<div class="flex flex-col gap-1 border-t border-zinc-200 px-4 py-3 dark:border-zinc-800">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/projects">Projects</HeaderLink>
				<HeaderLink href="/tags">Tags</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</div>
		</div>
	</div>
</header>

<script>
	const hamburgerBtn = document.getElementById('hamburger-btn');
	const mobileMenu = document.getElementById('mobile-menu');
	const iconOpen = document.getElementById('icon-open');
	const iconClose = document.getElementById('icon-close');

	function closeMenu() {
		mobileMenu?.classList.remove('grid-rows-[1fr]');
		mobileMenu?.classList.add('grid-rows-[0fr]');
		hamburgerBtn?.setAttribute('aria-expanded', 'false');
		iconOpen?.classList.remove('hidden');
		iconClose?.classList.add('hidden');
	}

	hamburgerBtn?.addEventListener('click', () => {
		const isOpen = mobileMenu?.classList.contains('grid-rows-[1fr]');
		if (isOpen) {
			closeMenu();
		} else {
			mobileMenu?.classList.remove('grid-rows-[0fr]');
			mobileMenu?.classList.add('grid-rows-[1fr]');
			hamburgerBtn?.setAttribute('aria-expanded', 'true');
			iconOpen?.classList.add('hidden');
			iconClose?.classList.remove('hidden');
		}
	});

	mobileMenu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', closeMenu);
	});
</script>
