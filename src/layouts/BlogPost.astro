---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	prevPost?: CollectionEntry<'blog'>;
	nextPost?: CollectionEntry<'blog'>;
};

const { title, author, description, pubDate, updatedDate, heroImage, tags = [], prevPost, nextPost } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
	<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
		<header class="mb-8 text-center">
			<div class="mb-3 flex items-center justify-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="italic">
							· Updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</div>
			<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
			{author && <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">By {author}</p>}
		</header>

		{
			heroImage && (
				<Image
					width={1020}
					height={510}
					src={heroImage}
					alt={title}
					class="mb-10 aspect-video w-full rounded-2xl object-cover shadow-lg"
				/>
			)
		}

		<div class="prose-content">
			<slot />
		</div>

		{
			tags.length > 0 && (
				<div class="mt-10 flex flex-wrap items-center gap-2">
					{tags.map((tag) => (
						<a
							href={`/tags/${tag}`}
							class="rounded-full bg-accent-50 px-3 py-1 text-sm font-medium text-accent-700 transition-colors hover:bg-accent-100 dark:bg-accent-500/10 dark:text-accent-300 dark:hover:bg-accent-500/20"
						>
							#{tag}
						</a>
					))}
				</div>
			)
		}

		{
			(prevPost || nextPost) && (
				<nav class="mt-12 grid gap-4 border-t border-zinc-200 pt-8 sm:grid-cols-2 dark:border-zinc-800">
					{prevPost ? (
						<a
							href={`/blog/${prevPost.id}/`}
							class="group rounded-xl border border-zinc-200 p-4 transition-colors hover:border-accent-400 hover:bg-zinc-50 dark:border-zinc-800 dark:hover:border-accent-500 dark:hover:bg-zinc-900"
						>
							<span class="text-xs text-zinc-500 dark:text-zinc-400">← Previous</span>
							<p class="mt-1 font-medium text-zinc-900 group-hover:text-accent-600 dark:text-zinc-100 dark:group-hover:text-accent-400">
								{prevPost.data.title}
							</p>
						</a>
					) : (
						<span />
					)}
					{nextPost && (
						<a
							href={`/blog/${nextPost.id}/`}
							class="group rounded-xl border border-zinc-200 p-4 text-right transition-colors hover:border-accent-400 hover:bg-zinc-50 dark:border-zinc-800 dark:hover:border-accent-500 dark:hover:bg-zinc-900"
						>
							<span class="text-xs text-zinc-500 dark:text-zinc-400">Next →</span>
							<p class="mt-1 font-medium text-zinc-900 group-hover:text-accent-600 dark:text-zinc-100 dark:group-hover:text-accent-400">
								{nextPost.data.title}
							</p>
						</a>
					)}
				</nav>
			)
		}
	</article>
</BaseLayout>
