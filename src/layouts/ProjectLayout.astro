---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'projects'>['data'] & {
	prevProject?: CollectionEntry<'projects'>;
	nextProject?: CollectionEntry<'projects'>;
};

const { title, author, description, pubDate, updatedDate, heroImage, github, tags = [], prevProject, nextProject } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
	<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
		<header class="mb-8 text-center">
			<div class="mb-3 flex items-center justify-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="italic">
							· Updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</div>
			<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
			{author && <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">By {author}</p>}

			<div class="mt-5 flex flex-wrap justify-center gap-3">
				<a
					href={github}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white"
				>
					<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
						<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
					</svg>
					View on GitHub
				</a>
			</div>
		</header>

		{
			heroImage && (
				<Image
					width={1020}
					height={510}
					src={heroImage}
					alt={title}
					class="mb-10 aspect-video w-full rounded-2xl object-cover shadow-lg"
				/>
			)
		}

		<div class="prose-content">
			<slot />
		</div>

		{
			tags.length > 0 && (
				<div class="mt-10 flex flex-wrap items-center gap-2">
					{tags.map((tag) => (
						<a
							href={`/tags/${tag}`}
							class="rounded-full bg-accent-50 px-3 py-1 text-sm font-medium text-accent-700 transition-colors hover:bg-accent-100 dark:bg-accent-500/10 dark:text-accent-300 dark:hover:bg-accent-500/20"
						>
							#{tag}
						</a>
					))}
				</div>
			)
		}

		{
			(prevProject || nextProject) && (
				<nav class="mt-12 grid gap-4 border-t border-zinc-200 pt-8 sm:grid-cols-2 dark:border-zinc-800">
					{prevProject ? (
						<a
							href={`/projects/${prevProject.id}/`}
							class="group rounded-xl border border-zinc-200 p-4 transition-colors hover:border-accent-400 hover:bg-zinc-50 dark:border-zinc-800 dark:hover:border-accent-500 dark:hover:bg-zinc-900"
						>
							<span class="text-xs text-zinc-500 dark:text-zinc-400">← Previous</span>
							<p class="mt-1 font-medium text-zinc-900 group-hover:text-accent-600 dark:text-zinc-100 dark:group-hover:text-accent-400">
								{prevProject.data.title}
							</p>
						</a>
					) : (
						<span />
					)}
					{nextProject && (
						<a
							href={`/projects/${nextProject.id}/`}
							class="group rounded-xl border border-zinc-200 p-4 text-right transition-colors hover:border-accent-400 hover:bg-zinc-50 dark:border-zinc-800 dark:hover:border-accent-500 dark:hover:bg-zinc-900"
						>
							<span class="text-xs text-zinc-500 dark:text-zinc-400">Next →</span>
							<p class="mt-1 font-medium text-zinc-900 group-hover:text-accent-600 dark:text-zinc-100 dark:group-hover:text-accent-400">
								{nextProject.data.title}
							</p>
						</a>
					)}
				</nav>
			)
		}
	</article>
</BaseLayout>
